---
import "../styles/global.css";
import BottomDock from "../components/BottomDock.astro";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es" class="overflow-x-hidden">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Space+Grotesk:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <BottomDock />
  </body>
</html>

<script>
  import { getTheme, setTheme } from "../utils/theme";
  import { getSavedLanguage, applyLanguage } from "../utils/language";
  import spanish from "../i18n/es.json";
  import english from "../i18n/en.json";

  var translations: Record<string, Record<string, string>> = {
    es: spanish,
    en: english,
  };

  var savedLang = getSavedLanguage();
  applyLanguage(savedLang, translations);

  function positionLangIndicator() {
    document.querySelectorAll(".lang-switch-wrapper").forEach(function (wrapper) {
      var indicator = wrapper.querySelector(".lang-indicator") as HTMLElement | null;
      var activeBtn = wrapper.querySelector(".lang-btn.text-primary") as HTMLElement | null;
      if (indicator == null || activeBtn == null) return;

      var wrapperRect = wrapper.getBoundingClientRect();
      var btnRect = activeBtn.getBoundingClientRect();
      indicator.style.left = btnRect.left - wrapperRect.left + "px";
    });
  }

  requestAnimationFrame(positionLangIndicator);
  window.addEventListener("resize", positionLangIndicator);

  (window as any).setLanguage = function (lang: string) {
    applyLanguage(lang, translations);

    document.querySelectorAll(".lang-btn").forEach(function (btn) {
      var code = btn.getAttribute("data-lang");
      if (code === lang) {
        btn.classList.add("text-primary", "font-bold");
        btn.classList.remove("text-muted-foreground");
      } else {
        btn.classList.remove("text-primary", "font-bold");
        btn.classList.add("text-muted-foreground");
      }
    });

    positionLangIndicator();
  };

  setTheme(getTheme());

  document.querySelectorAll(".theme-toggle").forEach(function (btn) {
    btn.addEventListener("click", function () {
      setTheme(getTheme() === "dark" ? "light" : "dark");
    });
  });

  document.querySelectorAll(".lang-btn").forEach(function (btn) {
    btn.addEventListener("click", function (e) {
      e.stopPropagation();
      var lang = btn.getAttribute("data-lang");
      if (lang) (window as any).setLanguage(lang);
    });
  });
</script>
