---
interface Experience {
  i18nKey: string;
  company: string;
  role: string;
  period: string;
  description: string;
  technologies: string[];
}

const experiences: Experience[] = [
  {
    i18nKey: "airpak",
    company: "AirPak",
    role: "Intern Software Developer",
    period: "2025 - Presente",
    description: "Mantenimiento y mejora de aplicaciones internas, desarrollo de nuevas funcionalidades y migración de sistemas legacy. Automatización de procesos con APIs REST y bases de datos, optimización en SQL Server/PostgreSQL, documentación técnica, monitoreo y participación en procesos ágiles y DevOps.",
    technologies: ["React", "ASP.NET", "SQL Server", "Docker", "Git", "PostgreSQL", "C4", "Structizr", "OpenSearch", "C#"],
  },
  {
    i18nKey: "nimac",
    company: "Nimac",
    role: "Software Developer",
    period: "2025 - 2026",
    description: "Desarrollo de sistemas empresariales para tareas e inventario, con automatización, dashboards, reportes e integración con AS/400. Uso de Clean Architecture y desarrollo de aplicaciones de escritorio con WinForms, WinUI 3 y SQL Server.",
    technologies: ["C#", "WinUI3", "SQL Server", "ODBC AS/400", "Windows Forms"],
  },
  {
    i18nKey: "vopper",
    company: "Vopper",
    role: "Backend Developer",
    period: "2023 - 2024",
    description: "Mantenimiento y desarrollo de servicios backend con Java y Spring, creación de APIs REST, lógica de negocio e integraciones. Implementación de seguridad con JWT y gestión de bases de datos PostgreSQL, optimizando rendimiento e integridad de datos.",
    technologies: ["Java", "Spring Boot", "Spring Security"],
  },
];
---

<section id="experiencia" class="px-6 sm:px-8 lg:px-12 py-24 sm:py-32 bg-muted/30 border-y border-border/50">
  <div class="max-w-5xl mx-auto">
    <div class="text-center mb-12 sm:mb-16">
      <h2 class="font-headings text-3xl sm:text-4xl mb-4 text-foreground scroll-animate" data-i18n="exp.title">
        Experiencia Laboral
      </h2>
      <p class="text-muted-foreground max-w-xl mx-auto scroll-animate" data-i18n="exp.subtitle">
        Mi trayectoria profesional en la industria tecnológica.
      </p>
    </div>
    <div class="relative">
      <!-- Timeline line -->
      <div class="absolute left-4 sm:left-1/2 top-0 bottom-0 w-px bg-border/50 -translate-x-1/2 hidden sm:block"></div>
      
      {experiences.map((exp, i) => (
        <div class={`scroll-animate flex flex-col sm:flex-row gap-8 mb-12 last:mb-0 ${
          i % 2 === 0 ? 'sm:flex-row-reverse' : ''
        }`}>
          <!-- Content -->
          <div class={`flex-1 ${i % 2 === 0 ? 'sm:text-right' : 'sm:text-left'}`}>
            <div class="bg-secondary p-6 rounded-xl border border-border hover:border-primary/30 transition-colors">
              <span class="inline-block text-xs font-mono text-primary mb-2 px-2 py-1 bg-primary/10 rounded-sm" data-i18n={"exp." + exp.i18nKey + ".period"}>
                {exp.period}
              </span>
              <h3 class="font-headings text-xl text-foreground mb-1" data-i18n={"exp." + exp.i18nKey + ".role"}>
                {exp.role}
              </h3>
              <p class="font-mono text-sm text-muted-foreground mb-4">
                {exp.company}
              </p>
              <p class="text-muted-foreground text-sm leading-relaxed mb-4" data-i18n={"exp." + exp.i18nKey + ".desc"}>
                {exp.description}
              </p>
              <div class={`flex flex-wrap gap-2 ${i % 2 === 0 ? 'sm:justify-end' : ''}`}>
                {exp.technologies.map((tech) => (
                  <span class="text-xs font-mono px-2 py-1 bg-muted text-primary rounded-sm border border-primary/20">
                    {tech}
                  </span>
                ))}
              </div>
            </div>
          </div>
          
          <!-- Timeline dot -->
          <div class="hidden sm:flex items-start justify-center">
            <div class="w-3 h-3 rounded-full bg-primary shadow-[0_0_8px_#a855f7] mt-8 flex-shrink-0 animate-pulse"></div>
          </div>
          
          <!-- Spacer -->
          <div class="flex-1 hidden sm:block"></div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('animate-in');
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.05 }
  );

  document.querySelectorAll('.scroll-animate').forEach((el) => {
    observer.observe(el);
  });
</script>

<style>
  .scroll-animate {
    opacity: 0;
    transform: translateY(15px);
    transition: opacity 0.35s ease-out, transform 0.35s ease-out;
  }

  .scroll-animate.animate-in {
    opacity: 1;
    transform: translateY(0);
  }
</style>
