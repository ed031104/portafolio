---
---

<section id="inicio" class="px-6 sm:px-8 lg:px-12 py-24 sm:py-32 flex flex-col items-center text-center relative">
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[min(600px,90vw)] h-[min(600px,90vw)] bg-primary/10 blur-[120px] rounded-full pointer-events-none"></div>
  
  <div class="hero-animate inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary/10 text-primary border border-primary/20 text-sm font-mono mb-8">
    <span class="w-2 h-2 rounded-full bg-primary shadow-[0_0_8px_#a855f7]"></span>
    <span data-i18n="hero.available">Disponible para proyectos</span>
  </div>
  
  <h1 class="hero-animate font-headings text-4xl sm:text-5xl lg:text-6xl max-w-4xl leading-tight mb-6 tracking-tight">
    <span data-i18n="hero.heading">Construyendo experiencias digitales</span>
    <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-neon" data-i18n="hero.heading.gradient">
      rápidas, escalables y memorables.
    </span>
  </h1>
  
  <p class="hero-animate text-lg sm:text-xl text-muted-foreground max-w-2xl mb-12" data-i18n="hero.subtitle">
    Soy un desarrollador Full-Stack apasionado por el código limpio y el diseño de interfaces modernas.
  </p>
  
  <div class="hero-animate flex flex-col sm:flex-row gap-4">
    <button
      id="CvButton"
      class="inline-flex items-center justify-center px-6 py-3 font-headings rounded-md gap-2 font-medium bg-primary text-primary-foreground shadow-[0_0_15px_rgba(168,85,247,0.5)] hover:bg-[#c084fc] transition-colors border-none cursor-pointer"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" x2="12" y1="15" y2="3"></line></svg>
      <span data-i18n="hero.downloadCv">
        Descargar CV
      </span>
    </button>
    <a
      href="https://github.com/ed031104"
      class="inline-flex items-center justify-center px-6 py-3 font-headings rounded-md gap-2 font-medium bg-secondary text-secondary-foreground border border-primary/30 hover:border-[#a855f7] hover:text-[#a855f7] transition-colors"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path><path d="M9 18c-4.51 2-5-2-7-2"></path></svg>
      <span>GitHub</span>
    </a>
    <a
      href="https://www.linkedin.com/in/edwin-d%C3%A1vila-527877267/"
      class="inline-flex items-center justify-center px-6 py-3 font-headings rounded-md gap-2 font-medium bg-secondary text-secondary-foreground border border-primary/30 hover:border-[#a855f7] hover:text-[#a855f7] transition-colors"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect width="4" height="12" x="2" y="9"></rect><circle cx="4" cy="4" r="2"></circle></svg>
      <span>LinkedIn</span>
    </a>
  </div>
</section>

<style>
  .hero-animate {
    opacity: 0;
    transform: translateY(30px);
    animation: heroFadeIn 0.7s ease-out forwards;
  }

  .hero-animate:nth-child(2) { animation-delay: 150ms; }
  .hero-animate:nth-child(4) { animation-delay: 250ms; }
  .hero-animate:nth-child(6) { animation-delay: 350ms; }
  .hero-animate:nth-child(7) { animation-delay: 450ms; }

  @keyframes heroFadeIn {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<script>
  import { downloadFile } from '../utils/FileDownload';

  const cvButton = document.querySelector('#CvButton');
  cvButton?.addEventListener('click', () => {
    downloadFile('/CvEdwin.pdf', 'CV_Edwin_Dávila.pdf');
  });
</script>